@baseUrl = http://localhost:3000
# Valor de ADMIN_TOKEN configurado no ambiente da API
@adminToken = troque-pelo-admin-token

### Checkout - sucesso (novo usuário)
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "Guilherme",
  "eml": "gui@fullcycle.com.br",
  "pwd": "senhaforte",
  "c_id": 2,
  "card": "4111222233334444"
}

### Checkout - pagamento recusado
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "João",
  "eml": "joao@teste.com",
  "pwd": "senhaforte",
  "c_id": 1,
  "card": "5111222233334444"
}

### Checkout - usuário existente precisa da senha correta (senão 401)
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "Guilherme",
  "eml": "gui@fullcycle.com.br",
  "pwd": "senhaforte",
  "c_id": 1,
  "card": "4111222233334444"
}

### Relatório financeiro administrativo (sem ADMIN_TOKEN configurado → 403)
GET {{baseUrl}}/api/admin/financial-report
X-Admin-Token: {{adminToken}}

### Deletar usuário
DELETE {{baseUrl}}/api/users/1
X-Admin-Token: {{adminToken}}
