# Copie para .env / exporte no ambiente. Nunca versione valores reais.
PORT=3000
# ":memory:" (padrão) ou caminho de arquivo SQLite
DB_PATH=:memory:
# Obrigatório para usar as rotas administrativas (header X-Admin-Token). Vazio = rotas admin respondem 403.
ADMIN_TOKEN=
LOG_LEVEL=info
# production = sem dados de demonstração
NODE_ENV=development
# Senha do usuário de demonstração do seed (se vazia, é gerada e exibida no log do boot)
SEED_USER_PASSWORD=
