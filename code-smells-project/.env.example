# Copie para .env (ou exporte no ambiente). Nunca versione valores reais.
SECRET_KEY=troque-por-um-valor-aleatorio
# Obrigatório para usar /admin/*: as rotas exigem o header X-Admin-Token com este valor.
# Vazio = rotas administrativas desabilitadas (403).
ADMIN_TOKEN=
FLASK_DEBUG=false
# Use 0.0.0.0 apenas em container/rede controlada.
HOST=127.0.0.1
PORT=5000
DATABASE_PATH=loja.db
# Origens permitidas, separadas por vírgula (ex.: http://localhost:3000). Vazio = CORS desabilitado.
CORS_ORIGINS=
# Seed de demonstração só roda com APP_ENV de desenvolvimento.
APP_ENV=desenvolvimento
# Senhas dos usuários de demonstração. Se vazias, são geradas e exibidas uma vez no log do boot.
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
