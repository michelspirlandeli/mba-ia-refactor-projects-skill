# Copie para .env (carregado automaticamente via python-dotenv). Nunca versione valores reais.
# development | production (em produção SECRET_KEY é obrigatório e o seed.py não roda)
APP_ENV=development
SECRET_KEY=troque-por-um-valor-aleatorio
DATABASE_URL=sqlite:///tasks.db
FLASK_DEBUG=false
# Use 0.0.0.0 apenas em container/rede controlada.
HOST=127.0.0.1
PORT=5000
# Origens permitidas, separadas por vírgula (ex.: http://localhost:3000). Vazio = CORS desabilitado.
CORS_ORIGINS=
# true (padrão) = todas as rotas, exceto /, /health, /login e POST /users, exigem "Authorization: Bearer <token>".
# false = autenticação/autorização desligadas (contrato legado, apenas desenvolvimento).
AUTH_REQUIRED=true
TOKEN_MAX_AGE_SECONDS=28800
# Bloqueio de login (429) após N falhas para o mesmo IP+email dentro da janela.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
# Senha dos usuários criados pelo seed.py (se vazia, é gerada e exibida no final do seed).
SEED_PASSWORD=
# Notificações por email (desligadas por padrão; enviadas em background)
NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=10
