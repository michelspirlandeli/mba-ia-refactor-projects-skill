# Copie para .env (carregado automaticamente via python-dotenv). Nunca versione valores reais.
SECRET_KEY=troque-por-um-valor-aleatorio
DATABASE_URL=sqlite:///tasks.db
FLASK_DEBUG=false
HOST=0.0.0.0
PORT=5000
CORS_ORIGINS=*
# true = todas as rotas (exceto /, /health, /login, POST /users) exigem "Authorization: Bearer <token>"
AUTH_REQUIRED=false
TOKEN_MAX_AGE_SECONDS=28800
# Notificações por email (desligadas por padrão)
NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
